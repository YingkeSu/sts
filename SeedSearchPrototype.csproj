<Project Sdk="Godot.NET.Sdk/4.5.1">
  <Import Project="./Sts2PathDiscovery.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SeedSearchPrototype</AssemblyName>
    <RootNamespace>SeedSearchPrototype</RootNamespace>
    <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <!-- Default builds install the mod into the game; pass -p:InstallMod=false to skip. -->
    <InstallMod Condition="'$(InstallMod)' == ''">true</InstallMod>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(Sts2DataDir)')">
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BaseLib">
      <HintPath>$(BaseLibPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SeedSearchPrototype/**" />
    <Compile Remove="tests/**" />
    <Compile Remove="tools/**" />
    <Compile Remove="docs/**" />
    <None Include="SeedSearchPrototype.json" />
    <None Include="project.godot" />
  </ItemGroup>

  <Target Name="CheckDependencyPaths" BeforeTargets="PrepareForBuild">
    <Error Text="Slay the Spire 2 data not found at '$(Sts2DataDir)'. Set STS2_GAME_PATH or pass -p:Sts2GamePath=..." Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
    <Error Text="BaseLib not found at '$(BaseLibPath)'. Set STS2_BASELIB_PATH or pass -p:BaseLibPath=..." Condition="'$(BaseLibPath)' == '' or !Exists('$(BaseLibPath)')" />
    <Error Text="InstallMod requires a Workshop id or ModsPath. Pass -p:Sts2ModWorkshopId=... or -p:ModsPath=..., or build with -p:InstallMod=false." Condition="'$(InstallMod)' == 'true' and '$(ModsPath)' == ''" />
    <MakeDir Directories="$(ModsPath)$(MSBuildProjectName)" Condition="'$(InstallMod)' == 'true' and '$(ModsPath)' != ''" />
  </Target>

  <Target Name="CopyToModsFolderOnBuild" AfterTargets="Build" Condition="'$(InstallMod)' == 'true' and '$(ModsPath)' != ''">
    <Message Text="Installing Seed Search DLL and manifest into $(ModsPath)$(MSBuildProjectName)" Importance="high" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/SeedSearchPrototype.json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)" />
  </Target>
</Project>
