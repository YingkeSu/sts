<Project>
  <PropertyGroup>
    <!--
      Per-machine game, data, mod, and dependency paths.

      Defaults are detected per OS below. Override them through the environment
      (STS2_GAME_PATH, STS2_STEAM_LIBRARY, STS2_BASELIB_PATH) or by passing
      -p:Sts2GamePath=... -p:Sts2SteamLibrary=... -p:BaseLibPath=...
      -p:Sts2ModWorkshopId=... -p:ModsPath=... when building.
    -->
    <Sts2GamePath Condition="'$(Sts2GamePath)' == ''">$(STS2_GAME_PATH)</Sts2GamePath>
    <Sts2SteamLibrary Condition="'$(Sts2SteamLibrary)' == ''">$(STS2_STEAM_LIBRARY)</Sts2SteamLibrary>
    <BaseLibPath Condition="'$(BaseLibPath)' == ''">$(STS2_BASELIB_PATH)</BaseLibPath>
    <Sts2AppId>2868840</Sts2AppId>
    <Sts2ModWorkshopId Condition="'$(Sts2ModWorkshopId)' == ''"></Sts2ModWorkshopId>
    <Sts2BaseLibWorkshopId>3737335127</Sts2BaseLibWorkshopId>
  </PropertyGroup>

  <Choose>
    <When Condition="'$(OS)' == 'Windows_NT'">
      <PropertyGroup>
        <Sts2GamePath Condition="'$(Sts2GamePath)' == '' and Exists('D:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64')">D:\SteamLibrary\steamapps\common\Slay the Spire 2</Sts2GamePath>
        <Sts2GamePath Condition="'$(Sts2GamePath)' == '' and Exists('C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64')">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</Sts2GamePath>
        <Sts2GamePath Condition="'$(Sts2GamePath)' == '' and Exists('C:\Program Files\Steam\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64')">C:\Program Files\Steam\steamapps\common\Slay the Spire 2</Sts2GamePath>
        <Sts2GamePath Condition="'$(Sts2GamePath)' == '' and Exists('E:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64')">E:\SteamLibrary\steamapps\common\Slay the Spire 2</Sts2GamePath>
        <Sts2GamePath Condition="'$(Sts2GamePath)' == '' and Exists('F:\SteamLibrary\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64')">F:\SteamLibrary\steamapps\common\Slay the Spire 2</Sts2GamePath>
        <Sts2DataDir Condition="'$(Sts2GamePath)' != ''">$(Sts2GamePath)\data_sts2_windows_x86_64</Sts2DataDir>
        <Sts2SteamLibrary Condition="'$(Sts2SteamLibrary)' == '' and '$(Sts2GamePath)' != ''">$([System.IO.Path]::GetFullPath('$(Sts2GamePath)\..\..\..'))</Sts2SteamLibrary>
        <BaseLibPath Condition="'$(BaseLibPath)' == '' and '$(Sts2SteamLibrary)' != ''">$(Sts2SteamLibrary)\steamapps\workshop\content\$(Sts2AppId)\$(Sts2BaseLibWorkshopId)\BaseLib\BaseLib.dll</BaseLibPath>
        <ModsPath Condition="'$(ModsPath)' == '' and '$(Sts2ModWorkshopId)' != '' and '$(Sts2SteamLibrary)' != ''">$(Sts2SteamLibrary)\steamapps\workshop\content\$(Sts2AppId)\$(Sts2ModWorkshopId)\</ModsPath>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <Sts2GamePath Condition="'$(Sts2GamePath)' == ''">/Users/suyingke/Library/Application Support/Steam/steamapps/common/Slay the Spire 2</Sts2GamePath>
        <Sts2DataDir Condition="'$(Sts2GamePath)' != ''">$(Sts2GamePath)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</Sts2DataDir>
        <Sts2SteamLibrary Condition="'$(Sts2SteamLibrary)' == ''">/Users/suyingke/Library/Application Support/Steam</Sts2SteamLibrary>
        <BaseLibPath Condition="'$(BaseLibPath)' == ''">$(Sts2SteamLibrary)/steamapps/workshop/content/$(Sts2AppId)/$(Sts2BaseLibWorkshopId)/BaseLib/BaseLib.dll</BaseLibPath>
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2GamePath)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
      </PropertyGroup>
    </Otherwise>
  </Choose>
</Project>
